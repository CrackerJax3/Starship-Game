rules_version = '2';

// Deploy: Firebase console -> Firestore Database -> Rules, paste this file,
// or `firebase deploy --only firestore:rules` if you use the Firebase CLI.
//
// These rules stop junk and impossible times from being written.
// They cannot stop a determined cheater who submits a believable time;
// that needs server-side validation (a Cloud Function) later.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'time', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.time is int
        && request.resource.data.time >= 10000      // keep in sync with MIN_TIME_MS
        && request.resource.data.time <= 3600000    // keep in sync with MAX_TIME_MS
        && request.resource.data.createdAt is int;

      allow update, delete: if false;
    }

    // Time-trial ghosts. Document ID = the score's document ID; the ghost must
    // match that score's name and time, so it can't be attached to someone else.
    match /ghosts/{ghostId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'time', 'v', 'data', 'splits', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.time is int
        && request.resource.data.v is int
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 200000   // keep in sync with GHOST_MAX_CHARS
        && request.resource.data.splits is string
        && request.resource.data.splits.size() <= 500
        && request.resource.data.createdAt is int
        && exists(/databases/$(database)/documents/scores/$(ghostId))
        && get(/databases/$(database)/documents/scores/$(ghostId)).data.name == request.resource.data.name
        && get(/databases/$(database)/documents/scores/$(ghostId)).data.time == request.resource.data.time;

      allow update, delete: if false;
    }
  }
}
